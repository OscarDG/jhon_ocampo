---
import  '../styles/global.css'

import Header from '../components/Header.astro'
import Header_second from '../components/Header_second.astro'
import Footer from '../components/Footer.astro'
interface Props {
	title?: string
}

const { title } : Props = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width initial-scale=1.0" />
		<link rel="icon" type="image/x-icon" href="/icons/monograma_janier_blanco_1.svg" />
		<meta name="description" content="" />
		<meta property="og:title" content="Janier Ocampo - Diseño" />
		<meta property="og:description" content="" />
		<meta property="og:site_name" content="Janier Ocampo - Diseño" />
		<meta property="og:type" content="website" />
		<meta property="og:image" content="/icons/logo.png" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="Janier Ocampo - Diseño" />
		<meta name="twitter:description" content="" />
		<title>{title}</title>
	</head>
	<body class="relative">
		{title === "Home" ? <Header /> : <Header_second />}
		<slot/>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
