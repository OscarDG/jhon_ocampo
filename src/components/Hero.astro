---
// Supports weights 100-400
import '@fontsource-variable/playwrite-au-nsw';

---
<section class="relative flex flex-row justify-center align-middle w-full h-screen py-5">
    <div class="absolute inset-0 bg-[url(../../public/hero_bg.jpg)] bg-cover bg-center" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="relative flex flex-col justify-end items-center w-2xl h-auto mb-5">
        <h1 class="font-extrabold text-7xl text-white text-center font-playwrite leading-normal mb-2">JHON OCAMPO</h1>
        <p class="w-98 text-white text-center font-bold mb-10">Diseñador Gráfico en formación | Identidad Visual & Diseño Digital</p>
        <p class="w-md text-white text-sm text-center font-poppins mb-10">Profesional en formación con un enfoque en soluciones visuales funcionales, identidad de marca y diseño digital.</p>
        <a class="flex flex-col justify-center box-border border border-transparent hover:border-sandibrown bg-jasmine p-5 rounded-4xl text-burntpeach font-bold font-poppins hover:bg-transparent hover:text-sandibrown hover:border" href="#projects" >Ver portafolio</a>
    </div>
    <div class="relative flex flex-col justify-end items-center w-2xl h-auto mb-10">
        <div class="w-90 h-110 overflow-hidden rounded-2xl">
            <img class="w-full h-full object-cover" src="/public/profile_img.jpg" alt="hero_image" loading="lazy" />
        </div>
    </div>
</section>