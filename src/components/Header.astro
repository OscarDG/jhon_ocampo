---
import '@fontsource/poppins'
---
<header class="absolute top-0 z-10 flex flex-row justify-center w-full h-auto">
    <div class="flex flex-row justify-between items-center w-full h-full bg-prusianblue rounded-b-4xl">
        <div class="h-auto justify-center items-center ml-20 mt-2">
            <a href="/" >
                <img src="/icons/logo.png" alt="Avatar" class="w-13 h-14 rounded-full" />
            </a>
        </div>
        <div class="flex flex-col h-auto justify-center items-center font-poppins mt-3 mb-3">
            <ul class="flex flex-row justify-around w-md">
                <li class="flex justify-center w-2/5 h-auto  p-2 rounded-2xl font-bold text-white hover:bg-gray-900 border-transparent hover:border-brand-gray/10">
                    <a href="/" target="_blank" class="mr-2">About me</a>
                    <svg  
                    width="24" height="24" viewBox="0 0 24 24" 
                    fill="none" stroke="currentColor" 
                    stroke-width="2" stroke-linecap="round" 
                    stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M5 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                    <path d="M3 21v-2a4 4 0 0 1 4 -4h4c.948 0 1.818 .33 2.504 .88" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" /><path d="M16 19h6" />
                </svg>
                </li>
                <li class="flex justify-center items center w-2/5 h-auto p-2 rounded-2xl font-bold text-white hover:bg-gray-900 border-transparent hover:border-brand-gray/10">
                    <a href='/' target="_blank" class="mr-2">Projects</a> 
                    <svg
                    width="25" height="25" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2" stroke-linecap="round" 
                    stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" 
                    fill="none"/>
                    <path d="M3 12c0 -4.243 0 -6.364 1.318 -7.682s3.44 -1.318 7.682 -1.318s6.364 0 7.682 1.318s1.318 3.44 1.318 7.682s0 6.364 -1.318 7.682s-3.44 1.318 -7.682 1.318s-6.364 0 -7.682 -1.318s-1.318 -3.44 -1.318 -7.682" />
                    <path d="M14.842 11.053v3.79c0 1.044 -.49 .946 -1.42 .946a2.368 2.368 0 0 1 0 -4.736zm0 0v-2.843" />
                    <path d="M8.211 8.211v7.578" />
                </svg>
                </li>
            </ul>
        </div>
    </div>
</header>