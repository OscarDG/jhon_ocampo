---
import '@fontsource/poppins'

---
<header class="absolute md:fixed top-0 left-0 z-10 flex justify-center w-full h-26 md:h-15 bg-transparent shadow">
    <nav class="layout_nav relative flex justify-between items-center w-full h-full p-5 md:p-6">
        <a href="/" class="relative flex justify-center items-center w-35 h-10 md:w-50 md:h-16 top-1 left-10">
            <img src="/icons/logo_horizontal.png" alt="Avatar" class="absolute right-1 w-35 h-10 md:w-50 md:h-10" />
        </a>
        <div class="header_menu hidden md:flex lg:flex w-auto h-full items-center font-poppins">
            <ul class="nav_ul flex flex-row justify-around w-md">
                <li class="flex justify-center items-center w-auto h-auto pt-2 pb-2 pl-5 pr-5 rounded-2xl text-sm text-verdigris cursor-pointer hover:text-white hover:bg-verdigris/50">
                    <a href="/about" class="mr-2">Sobre mi</a>
                    <svg  
                    width="20" height="20" viewBox="0 0 24 24" 
                    fill="none" stroke="currentColor" 
                    stroke-width="2" stroke-linecap="round" 
                    stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M5 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                    <path d="M3 21v-2a4 4 0 0 1 4 -4h4c.948 0 1.818 .33 2.504 .88" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" /><path d="M16 19h6" />
                </svg>
                </li>
                <li class="flex justify-center items-center w-auto h-auto pt-2 pb-2 pl-5 pr-5 rounded-2xl text-sm text-verdigris cursor-pointer hover:text-white hover:bg-verdigris/50">
                    <a href='/projects' class="mr-2">Proyectos</a> 
                    <svg
                    width="20" height="20" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2" stroke-linecap="round" 
                    stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" 
                    fill="none"/>
                    <path d="M3 12c0 -4.243 0 -6.364 1.318 -7.682s3.44 -1.318 7.682 -1.318s6.364 0 7.682 1.318s1.318 3.44 1.318 7.682s0 6.364 -1.318 7.682s-3.44 1.318 -7.682 1.318s-6.364 0 -7.682 -1.318s-1.318 -3.44 -1.318 -7.682" />
                    <path d="M14.842 11.053v3.79c0 1.044 -.49 .946 -1.42 .946a2.368 2.368 0 0 1 0 -4.736zm0 0v-2.843" />
                    <path d="M8.211 8.211v7.578" />
                </svg>
                </li>
            </ul>
        </div>
        <div class="mobile_menu relative flex justify-center items-center md:hidden w-16 h-16 p-2 bg-charcoalblue rounded-sm cursor-pointer">
            <div class="inner_menu relative w-[90%] h-[90%]">
                <span class="absolute top-0 w-full h-1 bg-white rounded-full"></span>
                <span class="absolute top-5 w-full h-1 bg-white rounded-full"></span>
                <span class="absolute bottom-0 w-full h-1 bg-white rounded-full"></span>
            </div>
        </div>
        <div class="mobile_inner_menu absolute md:hidden top-25 right-8 w-90 h-60 bg-amber-50/90 backdrop-blur-2xl rounded-2xl opacity-0 scale-0 pointer-event-none" aria-hidden="true">
            <ul class="flex flex-col justify-around w-full h-[90%]">
                <li class="flex justify-center items-center w-auto h-15 pl-5 pr-5 text-xl text-verdigris cursor-pointer hover:text-white hover:bg-verdigris/50">
                    <a href="/about" class="mr-2">Sobre mi</a>
                    <svg  
                    width="20" height="20" viewBox="0 0 24 24" 
                    fill="none" stroke="currentColor" 
                    stroke-width="2" stroke-linecap="round" 
                    stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M5 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                    <path d="M3 21v-2a4 4 0 0 1 4 -4h4c.948 0 1.818 .33 2.504 .88" />
                    <path d="M16 3.13a4 4 0 0 1 0 7.75" /><path d="M16 19h6" />
                </svg>
                </li>
                <li class="flex justify-center items-center w-auto h-15 pl-5 pr-5 text-xl text-verdigris cursor-pointer hover:text-white hover:bg-verdigris/50">
                    <a href='/projects' class="mr-2">Proyectos</a> 
                    <svg
                    width="20" height="20" 
                    viewBox="0 0 24 24" 
                    fill="none" 
                    stroke="currentColor" 
                    stroke-width="2" stroke-linecap="round" 
                    stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" 
                    fill="none"/>
                    <path d="M3 12c0 -4.243 0 -6.364 1.318 -7.682s3.44 -1.318 7.682 -1.318s6.364 0 7.682 1.318s1.318 3.44 1.318 7.682s0 6.364 -1.318 7.682s-3.44 1.318 -7.682 1.318s-6.364 0 -7.682 -1.318s-1.318 -3.44 -1.318 -7.682" />
                    <path d="M14.842 11.053v3.79c0 1.044 -.49 .946 -1.42 .946a2.368 2.368 0 0 1 0 -4.736zm0 0v-2.843" />
                    <path d="M8.211 8.211v7.578" />
                </svg>
                </li>
            </ul>
        </div>
    </nav>
</header>

<script>
    const menuBtn = document.querySelector('.mobile_menu')
    
    const innerMenu = menuBtn?.querySelector('.inner_menu')

    const mobileInnerMenu = document.querySelector('.mobile_inner_menu')

    menuBtn?.addEventListener('click', () => {

    innerMenu?.classList.toggle('active');

    mobileInnerMenu?.classList.toggle('active');

    });

</script>