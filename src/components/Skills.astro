---
import SkillCard from "./Skill_card.astro"

import { type Skills } from "../types/skills"
import { skills } from "../lib/skills"
import { techs } from "../lib/techs";
import { type Techs } from "../types/techs";

---

<section class="flex flex-col justify-center w-full h-auto bg-[#F5F5F4]">
    <div class="flex flex-col justify-center items-center w-full h-auto pt-10">
        <h1 class="mb-10 font-playwrite text-5xl text-lightblue">My skills</h1>
        <p class="text-md font-poppins">Proin consequat sit amet est in aliquet. Praesent luctus, ante efficitur dapibus porta.</p>
    </div>
    <div class="flex flex-row justify-start self-center flex-wrap p-10 gap-y-10 gap-x-10 w-[90%] h-auto">
        {
            skills.map((skill) => (
                <SkillCard id={skill.id} name={skill.name} level={skill.level} img_url={skill.img_url} desc={skill.desc}>
                    <img slot="icon" src={skill.svg} alt={skill.name} class="w-5 h-5"/>
                </SkillCard>
                ))
        }
    </div>
    <div class="flex flex-row justify-center w-full h-30 bg-lightblue">
        <div class="flex flex-row justify-around items-center w-[80%] h-auto">
            {
                techs.map((tech) => (
                    <div class="flex flex-col justify-center items-center w-20 h-20">
                        <div class="flex flex-col w-12 h-12 p-2 mb-2 bg-mainblue/50 rounded-full">
                            <img src={tech.icon} alt={tech.name} />
                        </div>
                        <span class="text-white font-poppins">{tech.name}</span>
                    </div>
                ))
            }
        </div>
    </div>
</section>