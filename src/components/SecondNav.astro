---
import Breadscrum from './Breadscrum.astro'

interface Props {
    labels: Array<{name: string, href: string}>,
    back_anchor: string
}

const { labels, back_anchor } : Props = Astro.props

const breadscrum = [
    {label: "Home", href: "/"},
    ...labels.map((labeled) => (
        {label: `${labeled.name}`, href: `${labeled.href}`}
    ))
]

---
<nav class="flex flex-row justify-between items-center w-full h-auto mb-10 font-bold pl-10 pr-10">
    <a href={back_anchor} class="group relative flex flex-row w-10 h-10 p-2 ml-0 text-white font-poppins rounded-full overflow-hidden bg-jasmine shadow-md shadow-black-200 transition-[width, border-radius] duration-500 ease[cubic-bezier(0.87, 0.04, 1, 1)] group-hover:duration hover:w-31 hover:rounded-4xl active:translate-x-0.5 active:translate-y-0.5">
        <img src="/icons/rowback.svg" alt="back" class="w-full rounded-full transition group-hover:duration-500 delay-75 group-hover:w-10"/>
        <span class="absolute -right-10 top-2 w-19 opacity-0 transition-all group-hover:duration-500 group-hover:opacity-100 group-hover:w-19 group-hover:right-1">Go back</span>
    </a>
    <div class="flex flex-col w-auto h-auto mr-0">
        <Breadscrum items={breadscrum} />
    </div>
</nav>