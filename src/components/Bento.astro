---
import type { Images, Tech } from '../types/projects'

interface Props {
    id?: number,
    images: Images[]
}

const { images } : Props = Astro.props
---
<div class="relative grid grid-cols-3 gap-3 w-full h-auto p-5">
{
    images.map((image) => (
        <img src={image.image_url} loading="lazy" class="w-full h-full rounded-2xl"/>
    ))
}
</div>