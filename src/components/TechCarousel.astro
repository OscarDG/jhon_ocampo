---
import { techs } from "../lib/techs";
import { type Techs } from "../types/techs";
---
    <div class="relative flex flex-row justify-center overflow-hidden w-full h-30 bg-[#F5F5F4]">
        <div class="animate-carousel flex flex-row justify-around items-center w-full h-auto animate-carousel gap-50">
            {
                techs.map((tech) => (
                    <div class="flex flex-col justify-center items-center w-20 h-20">
                        <div class="flex flex-col w-12 h-12 p-2 mb-2 bg-deepteal/50 rounded-full">
                            <img src={tech.icon} alt={tech.name} />
                        </div>
                        <span class="text-prusianblue font-poppins">{tech.name}</span>
                    </div>
                ))
            }
            {
                techs.map((tech) => (
                    <div class="flex flex-col justify-center items-center w-20 h-20">
                        <div class="flex flex-col w-12 h-12 p-2 mb-2 bg-deepteal/50 rounded-full">
                            <img src={tech.icon} alt={tech.name} />
                        </div>
                        <span class="text-prusianblue font-poppins">{tech.name}</span>
                    </div>
                ))
            }
        </div>
    </div>

    <style>
        @keyframes carousel {
            from{
                transform: translateX(0);
            }
            to{
                transform: translateX(-50%);
            }
            
        }

        .animate-carousel{
            animation: carousel 25s linear infinite
        }
    </style>