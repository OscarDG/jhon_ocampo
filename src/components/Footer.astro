---
import '@fontsource-variable/playwrite-au-nsw';

---
<footer class="relative flex flex-row justify-around items-center w-full h-dvh bg-charcoalblue">
    <div class="flex flex-col justify-center items-center w-100 h-100 gap-y-3">
        <h1 class="font-playwrite font-bold text-6xl text-white text-center leading-normal">JHON OCAMPO</h1>
        <p class="font-poppins text-jasmine">Diseñador Gráfico</p>
    </div>
    <div class="flex flex-col justify-center items-baseline w-100 h-100 gap-y-5 text-jasmine">
        <h2 class="text-2xl font-bold font-poppins">Contactarme</h2>
        <p class="text-md font-poppins"><span class="font-bold pr-2">Correo:</span>janier.ocampo@gmail.com</p>
        <p class="text-md font-poppins"><span class="font-bold pr-2">Telefono:</span> 318-7402683</p>
    </div>
    <div class="absolute bottom-10 flex flex-row justify-center items-center gap-5 w-[50%] h-[20%]">
        <a href="" target="_blank">
            <div class="flex flex-col w-12 h-12 transition duration-500 ease-in-out hover:scale-110">
                <img src="/icons/linkedin.svg" alt="LinkedIn" />
            </div>
        </a>
        <a href="" target="">
            <div class="flex flex-col w-12 h-12 transition duration-500 ease-in-out hover:scale-110">
                <img src="/icons/tiktok.svg" alt="Tik-Tok" />
            </div>
        </a>
        <a href="" target="_blank">
            <div class="flex flex-col w-12 h-12 transition duration-500 ease-in-out hover:scale-110">
                <img src="/icons/instagram.svg" alt="Instagram" />
            </div>
        </a>
    </div>
</footer>